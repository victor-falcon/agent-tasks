#!/usr/bin/env bun
// Entry point. Follows symlinks (e.g. ~/.local/bin/agent-tasks) to find the
// real checkout, then runs src/cli.ts from it.
import { realpathSync } from "node:fs";
import { dirname, join } from "node:path";

const root = dirname(dirname(realpathSync(import.meta.path)));
const { watchBackpressure, exitWhenFlushed } = await import(join(root, "src", "flush.ts"));
// Before anything writes: exiting must not cut output a pipe hasn't taken yet.
const streams = [watchBackpressure(process.stdout), watchBackpressure(process.stderr)];
const { main } = await import(join(root, "src", "cli.ts"));
await exitWhenFlushed(await main(process.argv.slice(2)), streams);
