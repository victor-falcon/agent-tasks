exports[`with every status show 1`] = `
"◐ Sentry summary (sentry-summary) · active

Folder        ~/Projects/foo
Schedule      every hour  (cron "0 * * * *" in Europe/Madrid)
Time zone     Europe/Madrid                                    ← task
Grace         15m (later than this, a slot is missed)          ← default (3 × runner.every, at least 15m)
Catch up      latest                                           ← default
Timeout       1h                                               ← profile ~/Projects/**
Retries       1                                                ← task
Keep open     on_failure                                       ← default
Notify        notifiers' own events                            ← default

Agent         clc (shell)                                      ← profile ~/Projects/**
Launcher      herdr (launch overridden)                        ← config
Skill         run-agent-task                                   ← default
Instructions  task + 3 personal files (3 missing)              ← profile ~/Projects/** (after config)

Created       Nov 1 10:00
Updated       Nov 1 10:00

Next runs
  Nov 17 11:00  in 58m
  Nov 17 12:00  in 2h
  Nov 17 13:00  in 3h

Last 10 occurrences
  RUN                              SLOT          STATUS        START  DURATION  ATT.  SUMMARY
  sentry-summary/20261117T090000Z  Nov 17 10:00  ◐ running     10:01  1m        1
  sentry-summary/20261117T080000Z  Nov 17 09:00  ✕ failed      09:02  3m        2/2   sentry-cli has no auth
  sentry-summary/20261117T070000Z  Nov 17 08:00  ■ ok          08:31  6m        1     3 new issues in notes/sentry.md
  sentry-summary/20261117T060000Z  Nov 17 07:00  - superseded  —      —         —     catch_up_latest
  sentry-summary/20261117T050000Z  Nov 17 06:00  - superseded  —      —         —     catch_up_latest
  sentry-summary/20261117T040000Z  Nov 17 05:00  - superseded  —      —         —     catch_up_latest
  sentry-summary/20261117T030000Z  Nov 17 04:00  □ missed      —      —         —     runner_offline
  sentry-summary/20261117T020000Z  Nov 17 03:00  □ missed      —      —         —     runner_offline
  sentry-summary/20261117T010000Z  Nov 17 02:00  □ missed      —      —         —     runner_offline
  sentry-summary/20261117T000000Z  Nov 17 01:00  ■ ok          01:01  3m        1     1 new issue in notes/sentry.md

Instructions as the agent gets them: agent-tasks show sentry-summary --instructions
"
`;

exports[`with every status show --instructions prints the task's and the personal ones, in order 1`] = `
"Task "Sentry summary" (sentry-summary), slot <slot>, attempt 1
Working directory: $HOME/Projects/foo

Do sentry summary.

User instructions (they take priority over the defaults above):

Write in English.

Use pnpm in foo.

When you are done, or if it fails, run:
  agent-tasks finish sentry-summary/<slot> --status succeeded|failed --summary "<what you did, where the result is>" [--output-file <file>]
"
`;

exports[`with every status log: events, attempts and the captured log: failed run 1`] = `
"✕ failed  sentry-summary/20261117T080000Z · slot Nov 17 09:00

