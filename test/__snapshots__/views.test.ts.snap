// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`empty state status says the runner never ran and there are no tasks, and exits 1: stderr 1`] = `
"! runner is not running (no tick recorded yet); scheduled tasks won't start. Start it with: agent-tasks runner
"
`;

exports[`empty state status says the runner never ran and there are no tasks, and exits 1: stdout 1`] = `
"Runner    ✕ not running · no tick recorded yet · start it with: agent-tasks runner
Last 24h  0 ok · 0 failed · 0 missed
Now       0 running · 0 blocked
No tasks yet. Create one with: agent-tasks add --title … --cron … --instructions …
"
`;

exports[`empty state list and runs 1`] = `
"No tasks. Create one with: agent-tasks add --title … --cron … --instructions …
"
`;

